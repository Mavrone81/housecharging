# Copy to .env and fill in. Never commit your real .env (it's gitignored).
#
# For docker-compose, only these three are required (compose substitutes them):
#   POSTGRES_PASSWORD   strong DB password (used by both the db and the app's DATABASE_URL)
#   JWT_SECRET          long random string for signing login tokens
#   ADMIN_PASSWORD      strong admin password
# Generate strong values, e.g.:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# PostgreSQL connection string (used when running WITHOUT docker-compose).
# Local Docker (see docker-compose.yml):
DATABASE_URL=postgres://mcts:mcts@localhost:5432/mcts
# Managed hosts (Render/Railway/Supabase) give you a URL like:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# If your host requires SSL, set:
PGSSL=false

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Seed admin account (created on first migrate if it doesn't exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Server port (most hosts set PORT automatically).
PORT=3000

# Comma-separated allowed origins for CORS. Leave blank to allow same-origin only
# (the web client is served by this same server, so blank is fine for most setups).
CORS_ORIGINS=

# Set to "true" once to load demo houses/readings/owners on migrate (optional).
SEED_DEMO=false
